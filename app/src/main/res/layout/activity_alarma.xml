<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/alarm_gradient_bg">

    <!-- Pulsing sonar rings (start invisible, animated in Java) -->
    <View
        android:id="@+id/ring1"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/ring_pulse" />

    <View
        android:id="@+id/ring2"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/ring_pulse" />

    <View
        android:id="@+id/ring3"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:background="@drawable/ring_pulse" />

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageButton
            android:id="@+id/btnAlarma"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:background="@drawable/alarm_icon_bg"
            android:contentDescription="@string/app_name"
            android:padding="24dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/icono" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:letterSpacing="0.03"
            android:text="@string/noTePases"
            android:textColor="#FFFFFF"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:text="Toca el ícono para detener"
            android:textColor="#80FFFFFF"
            android:textSize="15sp" />

    </LinearLayout>

</FrameLayout>
